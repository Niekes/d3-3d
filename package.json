{
    "name": "d3-3d",
    "version": "2.4.3",
    "description": "3D charts and shapes for D3.js. Projects 3D data to plain SVG or canvas, no WebGL needed. TypeScript.",
    "keywords": [
        "3D",
        "d3",
        "d3-3d",
        "d3-module",
        "projection",
        "typescript",
        "visualization"
    ],
    "homepage": "https://niekes.github.io/d3-3d/",
    "bugs": {
        "url": "https://github.com/Niekes/d3-3d/issues"
    },
    "license": "BSD-3-Clause",
    "author": "Niekes (https://niekes.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Niekes/d3-3d.git"
    },
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/niekes"
    },
    "files": [
        "build/d3-3d.js",
        "build/d3-3d.es.js",
        "build/d3-3d.cjs",
        "build/index.d.ts",
        "build/**/*.d.ts"
    ],
    "type": "module",
    "main": "build/d3-3d.cjs",
    "module": "build/d3-3d.es.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/d3-3d.es.js",
            "require": "./build/d3-3d.cjs"
        }
    },
    "scripts": {
        "clean": "rm -rf build",
        "typecheck": "tsc --noEmit",
        "build:js": "vp pack",
        "build": "npm run clean && npm run typecheck && npm run build:js",
        "pretest": "npm run typecheck",
        "test": "vp test run",
        "test:watch": "vp test",
        "test:ui": "vp test --ui",
        "coverage": "vp test run --coverage",
        "docs:dev": "node scripts/sort-examples.mjs && vitepress dev docs",
        "docs:build": "node scripts/sort-examples.mjs && vitepress build docs",
        "docs:check": "node scripts/sort-examples.mjs --check",
        "docs:preview": "vitepress preview docs",
        "lint:template": "node scripts/check-template.mjs",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "lint": "npm run lint:template && npm run lint:fallow",
        "verify": "npm run typecheck && npm run coverage && npm run lint",
        "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude && fallow hooks install --target agent --agent codex",
        "prepack": "npm run build",
        "postpublish": "zip -j build/d3-3d.zip -- LICENSE README.md build/d3-3d.js build/d3-3d.es.js build/d3-3d.cjs"
    },
    "devDependencies": {
        "@types/d3": "^7.4.3",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/ui": "5.1.0",
        "d3": "^7.9.2",
        "fallow": "3.46.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vite-plus": "1.7.0",
        "vitepress": "^2.0.0-alpha.21",
        "vitest": "5.1.0"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
        "vitest": "5.1.0"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    }
}
