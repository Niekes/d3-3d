{
    "name": "d3-3d",
    "version": "2.1.0",
    "description": "D3.js plugin for 3d visualization written in Typescript",
    "keywords": [
        "3D",
        "d3",
        "d3-3d",
        "d3-module",
        "projection",
        "typescript",
        "visualization"
    ],
    "homepage": "https://github.com/niekes/d3-3d",
    "license": "BSD-3-Clause",
    "author": "Niekes (https://niekes.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/niekes/d3-3d.git"
    },
    "files": [
        "build/d3-3d.js",
        "build/d3-3d.es.js",
        "build/d3-3d.cjs",
        "build/index.d.ts",
        "build/**/*.d.ts"
    ],
    "type": "module",
    "main": "build/d3-3d.cjs",
    "module": "build/d3-3d.es.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/d3-3d.es.js",
            "require": "./build/d3-3d.cjs"
        }
    },
    "scripts": {
        "clean": "rm -rf build",
        "typecheck": "tsc --noEmit",
        "build:js": "vp pack",
        "build": "npm run clean && npm run typecheck && npm run build:js",
        "pretest": "npm run typecheck",
        "test": "vp test run",
        "test:watch": "vp test",
        "test:ui": "vp test --ui",
        "coverage": "vp test run --coverage",
        "lint:template": "node scripts/check-template.mjs",
        "lint:fallow": "fallow dead-code --ci --format ${FALLOW_FORMAT:-human} && fallow health --ci --coverage-gaps --format ${FALLOW_FORMAT:-human} && fallow dupes --ci --format ${FALLOW_FORMAT:-human}",
        "lint": "npm run lint:template && npm run lint:fallow",
        "hooks:install": "fallow hooks install --target git && fallow hooks install --target agent --agent claude && fallow hooks install --target agent --agent codex",
        "prepack": "npm run build",
        "postpublish": "zip -j build/d3-3d.zip -- LICENSE README.md build/d3-3d.js build/d3-3d.es.js build/d3-3d.cjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "fallow": "3.34.1",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vitest": "5.0.5"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vitest": "5.0.5"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0 || ^24.11.0 || >=26.0.0"
        }
    }
}
