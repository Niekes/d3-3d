{
    "name": "d3-3d",
    "version": "2.0.2",
    "description": "D3.js plugin for 3d visualization written in Typescript",
    "keywords": [
        "d3",
        "d3-module",
        "3D",
        "d3-3d",
        "projection",
        "typescript",
        "visualization"
    ],
    "author": "Niekes (https://niekes.com)",
    "license": "BSD-3-Clause",
    "homepage": "https://github.com/niekes/d3-3d",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/niekes/d3-3d.git"
    },
    "type": "module",
    "main": "build/d3-3d.cjs",
    "module": "build/d3-3d.es.js",
    "types": "build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/d3-3d.es.js",
            "require": "./build/d3-3d.cjs"
        }
    },
    "files": [
        "build/d3-3d.js",
        "build/d3-3d.es.js",
        "build/d3-3d.cjs",
        "build/index.d.ts",
        "build/**/*.d.ts"
    ],
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.12.0 || ^24.0.0 || >=26.0.0"
        }
    },
    "scripts": {
        "clean": "rm -rf build",
        "typecheck": "tsc --noEmit",
        "build:types": "tsc -p tsconfig.build.json",
        "build:js": "vite build",
        "build": "npm run clean && npm run typecheck && npm run build:types && npm run build:js",
        "pretest": "npm run typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "coverage": "vitest run --coverage",
        "prepack": "npm run build",
        "postpublish": "zip -j build/d3-3d.zip -- LICENSE README.md build/d3-3d.js build/d3-3d.es.js build/d3-3d.cjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "5.0.5"
    }
}
